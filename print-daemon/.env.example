# WordPress API URL (your restaurant site)
ROP_API_URL=http://localhost:8080

# API key from WooCommerce > Kitchen Print settings
ROP_API_KEY=change-me-after-setup

# Printer target:
#   network://192.168.1.100:9100  - Network ESC/POS printer (port 9100 is default)
#   file:///tmp/kitchen-tickets.txt - Write tickets to file (for testing)
ROP_PRINTER=file:///tmp/kitchen-tickets.txt

# How often to check for new tickets (milliseconds)
ROP_POLL_MS=3000
