---
import Layout from '../components/Layout.astro';
---

<Layout
  title="Contact"
  description="Start a brand, corporate identity, or website project with D. Philhower Studio."
  path="/contact"
  headerTheme="dark"
>
  <header class="page-hero">
    <p class="brand-line">D. Philhower Studio</p>
    <div class="deco-rule" aria-hidden="true"></div>
    <h1>Tell us about the work ahead.</h1>
    <p>Share a few details and we’ll reply within two business days.</p>
  </header>

  <section class="section contact-layout reveal" aria-label="Contact">
    <div class="contact-details">
      <div>
        <p class="section-label">Email</p>
        <a href="mailto:hello@dphilhowerstudio.com">hello@dphilhowerstudio.com</a>
      </div>
      <div>
        <p class="section-label">Focus</p>
        <p style="color: var(--ink-soft); max-width: 30ch;">
          Custom brand creation, corporate identity for family businesses, and website design.
        </p>
      </div>
      <div>
        <p class="section-label">Typical timeline</p>
        <p style="color: var(--ink-soft); max-width: 30ch;">
          Brand systems from 4–8 weeks. Websites from 6–12 weeks, depending on scope.
        </p>
      </div>
    </div>

    <form class="contact-form" id="contact-form" novalidate>
      <div class="form-success" role="status">
        Thanks — your message is ready to send. We’ll be in touch soon. For now, you can also email
        <a href="mailto:hello@dphilhowerstudio.com" style="color: var(--brass-soft);">hello@dphilhowerstudio.com</a>.
      </div>
      <div class="form-fields">
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="company">Company / family business</label>
          <input id="company" name="company" type="text" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="interest">I’m interested in</label>
          <select id="interest" name="interest" required>
            <option value="">Select one</option>
            <option value="brand">Custom brand creation</option>
            <option value="family-ci">Corporate identity for family business</option>
            <option value="website">Website design</option>
            <option value="both">Brand + website</option>
            <option value="other">Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Project notes</label>
          <textarea
            id="message"
            name="message"
            required
            placeholder="Goals, history, timeline, links — anything useful…"></textarea>
        </div>
        <button class="btn btn-ink" type="submit">Send message</button>
        <p class="form-note">
          Prefer email? Write directly to
          <a href="mailto:hello@dphilhowerstudio.com">hello@dphilhowerstudio.com</a>.
        </p>
      </div>
    </form>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const data = new FormData(form);
    const name = String(data.get('name') || '');
    const email = String(data.get('email') || '');
    const company = String(data.get('company') || '');
    const interest = String(data.get('interest') || '');
    const message = String(data.get('message') || '');
    const subject = encodeURIComponent(`Project inquiry from ${name}`);
    const body = encodeURIComponent(
      `Name: ${name}\nEmail: ${email}\nCompany: ${company}\nInterest: ${interest}\n\n${message}`
    );
    form.classList.add('is-sent');
    window.location.href = `mailto:hello@dphilhowerstudio.com?subject=${subject}&body=${body}`;
  });
</script>
