---
import Layout from '../components/Layout.astro';
---

<Layout title="Astro Quickstart">
	<main>
    <svg id="background" width='1728' height='1235' viewBox="0 0 1728 1235" fill='none' xmlns='http://www.w3.org/2000/svg'><g opacity='0.75' filter='url(#filter0_f_39_143)'><circle cy='1000' r='264' fill='url(#paint0_linear_39_143)'/></g><g opacity='0.65' filter='url(#filter1_f_39_143)'><circle cx='1720' cy='264' r='379' fill='url(#paint1_linear_39_143)'/></g><defs><filter id='filter0_f_39_143' x='-485' y='515' width='970' height='970' filterUnits='userSpaceOnUse' color-interpolation-filters='sRGB'><feFlood flood-opacity='0' result='BackgroundImageFix'/><feBlend mode='normal' in='SourceGraphic' in2='BackgroundImageFix' result='shape'/><feGaussianBlur stdDeviation='110.5' result='effect1_foregroundBlur_39_143'/></filter><filter id='filter1_f_39_143' x='1120' y='-336' width='1200' height='1200' filterUnits='userSpaceOnUse' color-interpolation-filters='sRGB'><feFlood flood-opacity='0' result='BackgroundImageFix'/><feBlend mode='normal' in='SourceGraphic' in2='BackgroundImageFix' result='shape'/><feGaussianBlur stdDeviation='110.5' result='effect1_foregroundBlur_39_143'/></filter><linearGradient id='paint0_linear_39_143' x1='196.5' y1='902' x2='-2.55853e-05' y2='1264' gradientUnits='userSpaceOnUse'><stop stop-color="var(--bttm-left-blur-1)"/><stop offset='1' stop-color="var(--bttm-left-blur-2)"/></linearGradient><linearGradient id='paint1_linear_39_143' x1='1720' y1='-115' x2='1720' y2='643' gradientUnits='userSpaceOnUse'><stop stop-color="var(--top-right-blur-1)"/><stop offset='1' stop-color="var(--top-right-blur-2)" /></linearGradient></defs></svg>     
    <div id="content">
      <div class="header">
        <h1 class="animate-on-scroll from-bottom" style="--animate-delay: 0ms">Quickstart Template</h1>
        <div class="logo animate-on-scroll from-left" style="--animate-delay: 100ms">
          <img src="https://user-images.githubusercontent.com/43764894/223559085-8ff69d2f-4247-427f-a3a6-d2036b00082a.png" alt="Netlify plus Astro banner">
        </div>
        <h2 class="animate-on-scroll from-right" style="--animate-delay: 200ms">
          This is a bare-bones Astro project that has everything you need to quickly deploy it to Netlify
        </h2>
        <div class="bttns">
          <a href="https://app.netlify.com/start/deploy?repository=https://github.com/netlify-templates/astro-quickstart" class="bttn primary animate-on-scroll from-left" style="--animate-delay: 300ms">Deploy to Netlify</a>
          <a href="https://github.com/netlify-templates/astro-quickstart" class="bttn secondary animate-on-scroll from-right" style="--animate-delay: 380ms">View Repo</a>
        </div>
      </div>
			<section class="resource-list">
        <h2 class="animate-on-scroll from-bottom" style="--animate-delay: 0ms">Resources</h2>
        <ul>
          <li class="animate-on-scroll from-left" style="--animate-delay: 100ms">
            <a href="https://ntl.fyi/38O9wmY">Netlify Blog: Astro posts</a>
					</li>
          <li class="animate-on-scroll from-bottom" style="--animate-delay: 180ms">
            <a href="https://ntl.fyi/3KHGtyz">Netlify Docs</a>
          </li>
          <li class="animate-on-scroll from-right" style="--animate-delay: 260ms">
            <a href="https://docs.astro.build/en/getting-started/">Astro Docs</a>
          </li>
        </ul>
      </section>
      <section class="features">
        <h2 class="animate-on-scroll from-bottom" style="--animate-delay: 0ms">Built for a fast start</h2>
        <p class="animate-on-scroll from-left" style="--animate-delay: 100ms">
          Ship a polished Astro site with Netlify-ready defaults, clear structure, and room to grow.
        </p>
        <ul class="feature-grid">
          <li class="animate-on-scroll from-left" style="--animate-delay: 160ms">
            <h3>Astro-first</h3>
            <p>Component islands, static output, and a lean project layout out of the box.</p>
          </li>
          <li class="animate-on-scroll from-bottom" style="--animate-delay: 240ms">
            <h3>Netlify-ready</h3>
            <p>Deploy with one click and keep iterating with continuous deploys from Git.</p>
          </li>
          <li class="animate-on-scroll from-right" style="--animate-delay: 320ms">
            <h3>Scroll motion</h3>
            <p>Every layout element slides into place as it enters the viewport.</p>
          </li>
        </ul>
      </section>
      <section class="next-steps">
        <h2 class="animate-on-scroll from-top" style="--animate-delay: 0ms">Next steps</h2>
        <p class="animate-on-scroll from-right" style="--animate-delay: 100ms">
          Customize the template, connect your repo, and deploy when you are ready.
        </p>
        <div class="bttns">
          <a href="https://docs.astro.build/en/getting-started/" class="bttn primary animate-on-scroll from-left" style="--animate-delay: 180ms">Astro Docs</a>
          <a href="https://docs.netlify.com/" class="bttn secondary animate-on-scroll from-right" style="--animate-delay: 260ms">Netlify Docs</a>
        </div>
      </section>
    </div>
	</main>
</Layout>
