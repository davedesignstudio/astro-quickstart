---
import Layout from '../components/Layout.astro';

const swedishDesigners = [
  {
    name: 'Anders Beckman',
    note: 'Pioneer of Swedish advertising art; founded Beckmans College of Design (1939). Complete identity for the Helsingborg H55 exhibition; World’s Fair presence that put Swedish functional design on a global stage.',
  },
  {
    name: 'Karl-Erik Forsberg',
    note: 'Calligrapher and type designer of Berling Antikva. Marks and identities for Volvo, Swedish Radio, the Royal Library, Stockholm University, and Stockholm’s civic arms — letterforms as national infrastructure.',
  },
  {
    name: 'Olle Eksell',
    note: 'Sweden’s first modern design program for Mazetti (Ögon Cacao, 1956). Author of Design = Economy. Friend of Paul Rand; later celebrated in Japan’s IDEA magazine with a Japanese monograph.',
  },
  {
    name: 'Rune Söderqvist',
    note: 'ABBA logotype (the mirrored B) — Swedish graphic wit scaled into one of the world’s most recognized entertainment marks.',
  },
  {
    name: 'Bo Berndal',
    note: 'Type designer of 300+ faces; first Berling Prize recipient. Esseltub for Stockholm’s subway wayfinding — Swedish systems design in public space.',
  },
  {
    name: 'Clara von Zweigbergk',
    note: 'Color, paper, and balance. Formed HAY’s visual identity and HAY Tokyo — a living Sweden–Japan bridge in contemporary brand craft.',
  },
];

const swedishStudios = [
  {
    name: 'Stockholm Design Lab',
    note: 'Precision, multidisciplinary identity systems spanning print, environment, and brand architecture — clarity as a competitive advantage.',
  },
  {
    name: 'Bedow',
    note: 'Strategic branding with narrative craft for companies with intent — iterative process from first principles.',
  },
  {
    name: 'The Studio · SNASK · Affairs · Yuppie',
    note: 'Lifestyle branding for Svenskt Tenn and Verso; bold disruptive personality; dual professionalism/passion; adaptive Stockholm brand work.',
  },
];

const swedishBrands = [
  {
    name: 'IKEA',
    note: 'Family-founded Småland company whose blue/yellow mark and IKEA Sans export Swedish identity globally. Lesson: consistency over constant redesign; heritage encoded in acronym and color.',
  },
  {
    name: 'Absolut',
    note: 'Headline vs Script contrast — contemporary premium meeting creative personality. A Swedish brand system built on typographic duality.',
  },
  {
    name: 'Svenskt Tenn',
    note: 'Founded 1924 by Estrid Ericson with Josef Frank. 1930s modernism still current — pattern, craft, and seasonal campaigns that refresh without erasing DNA.',
  },
  {
    name: 'Acne Studios',
    note: 'Stockholm wordmark culture: refined typographic identity as the brand. Proof that Swedish modern brands lead with letterforms.',
  },
];

const japanese = [
  {
    name: 'Yusaku Kamekura',
    note: '“Boss” of postwar Japanese graphic design. Tokyo 1964 Olympic identity and corporate marks for Nikon, NTT, Meiji, TDK — family-crest (mon) reduction meeting Western geometry.',
  },
  {
    name: 'Nippon Design Center',
    note: 'Corporate-backed house agency Kamekura helped establish with Asahi, Toyota, Nomura, JR, Toshiba — proving identity systems as industrial infrastructure.',
  },
  {
    name: 'Ma (間)',
    note: 'The beauty of interval. Negative space as structure, not emptiness — a core principle shared with Scandinavian editing and modern brand interfaces.',
  },
  {
    name: 'Japandi',
    note: 'Natural overlap of Japanese restraint and Scandinavian functionalism: honest materials, edited compositions, calm authority without coldness.',
  },
  {
    name: 'Eksell ↔ Japan',
    note: 'Historical bridge: Eksell exhibited with Yusaku Kamekura in London packaging shows; Japanese IDEA named him among the world’s best; his monograph was published in Japan (2006).',
  },
];

const decoAndWall = [
  {
    name: 'Art Deco geometry',
    note: '1920s–30s commercial modernism: tall spaced capitals, chevrons, stepped forms, symmetry, metallic accents. Cassandre’s Bifur/Acier Noir lineage. Used here as structure — not costume pastiche.',
  },
  {
    name: 'CBS Gastrotypographicalassemblage',
    note: 'Lou Dorfsman’s 1966 type wall for the cafeteria in Eero Saarinen’s CBS Building (“Black Rock”), composed with Herb Lubalin and Tom Carnase. ~1,650 hand-milled wooden letters + sculptural objects — typography as architectural appetite. Restored at the Culinary Institute of America.',
  },
  {
    name: 'Why it matters here',
    note: 'The wall turns brand vocabulary into a physical surface — mixed scale, mixed faces, compartmental energy like a typesetter’s tray on its side. That hunger powers our type-wall assemblage.',
  },
];

const familyCases = [
  {
    name: 'Peregrine (8th generation)',
    note: 'Heritage clothier modernized with bold type, badge/inktrap details, and a Shopify site built for loyal return visitors — past and present in one system.',
  },
  {
    name: 'Pitcairn (100+ years)',
    note: 'Family office → multi-family advisory. Brand and website recentered on family as the product; classic appeal kept, type/palette/photography elevated.',
  },
  {
    name: 'Kocbek (since 1929)',
    note: 'Three-generation mill abstracted its founding mill wheel into a mark that works in Ljubljana and London — craft proven, not merely claimed.',
  },
  {
    name: 'Watson Bros (est. 1885)',
    note: 'Dual-audience identity: contemporary wordmark + heritage seal + digital monogram. Website shifted from PDF-catalog feel to editorial workshop storytelling.',
  },
  {
    name: 'Genesee · J.M. Smucker · Land O’Lakes',
    note: 'Heritage CPG lessons: elevate what locals already love; family CEOs can champion bold CI when the business has outgrown the old mark; simplify for shelf and story.',
  },
  {
    name: 'IKEA (Kamprad family origin)',
    note: 'Swedish family-business archetype at global scale — name encodes place and founder; visual profile manuals in the 1980s ended logo drift.',
  },
];

const familyPrinciples = [
  {
    title: 'Heritage is strategy, not decoration',
    body: 'Origin stories, workshop photos, founding decisions, and craft methods are assets. Nostalgia costumes underperform documented provenance.',
  },
  {
    title: 'Run the continuity filter',
    body: 'Before any new expression ships: does this continue the family story, or abandon it? Identity must bend across generations without breaking.',
  },
  {
    title: 'Build dual-audience systems',
    body: 'Primary modern mark + heritage lockups + digital icons. Older stewards and younger buyers need different doors into the same house.',
  },
  {
    title: 'Make the website editorial, not archival',
    body: 'Successful family CI sites read like living magazines of craft — clear journeys, people at the center, history as context not the only content.',
  },
  {
    title: 'Protect visual equities, retire clutter',
    body: 'Keep the colors, crests, or word shapes that still earn recognition. Remove symbols that no longer tell the truth of the business.',
  },
  {
    title: 'Hand off for the next steward',
    body: 'Guidelines, asset libraries, and site systems documented so the next generation can build — not start over.',
  },
];
---

<Layout
  title="Influences"
  description="Deep research informing D. Philhower Studio — Swedish graphic designers and brands, Japanese corporate identity, Art Deco, the CBS cafeteria type wall, and family-business branding websites."
  path="/influences"
  headerTheme="dark"
>
  <header class="page-hero">
    <p class="brand-line">D. Philhower Studio</p>
    <div class="deco-rule" aria-hidden="true"></div>
    <h1>Research behind the studio language.</h1>
    <p>
      A working atlas of Swedish graphic designers and modern brands, Japanese influence, Art Deco structure,
      CBS cafeteria type-wall energy, and what past websites get right about branding and corporate identity
      for family businesses.
    </p>
  </header>

  <section class="section reveal" aria-labelledby="sweden-title">
    <p class="section-label">Sweden · designers</p>
    <div class="deco-rule" aria-hidden="true"></div>
    <h2 class="section-title" id="sweden-title">Swedish graphic designers</h2>
    <p class="section-lead">
      Functionalism with wit. Design treated as economy. Letterforms and systems as national infrastructure.
    </p>
    <ul class="lineage">
      {
        swedishDesigners.map((item) => (
          <li>
            <strong>{item.name}</strong>
            <span>{item.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section reveal" aria-labelledby="studios-title">
    <p class="section-label">Sweden · studios now</p>
    <div class="deco-rule" aria-hidden="true"></div>
    <h2 class="section-title" id="studios-title">Contemporary Stockholm practice</h2>
    <ul class="lineage">
      {
        swedishStudios.map((item) => (
          <li>
            <strong>{item.name}</strong>
            <span>{item.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section reveal" aria-labelledby="brands-title">
    <p class="section-label">Sweden · modern brands</p>
    <div class="deco-rule" aria-hidden="true"></div>
    <h2 class="section-title" id="brands-title">Graphic brands shaped by Swedish culture</h2>
    <p class="section-lead">
      Exportable clarity, typographic confidence, and heritage that still feels contemporary.
    </p>
    <ul class="lineage">
      {
        swedishBrands.map((item) => (
          <li>
            <strong>{item.name}</strong>
            <span>{item.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section reveal" aria-labelledby="japan-title">
    <p class="section-label">Japan</p>
    <div class="deco-rule" aria-hidden="true"></div>
    <h2 class="section-title" id="japan-title">Japanese influence & corporate marks</h2>
    <p class="section-lead">
      Reduction, harmony, and scalable identity systems — and a documented dialogue with Swedish design.
    </p>
    <ul class="lineage">
      {
        japanese.map((item) => (
          <li>
            <strong>{item.name}</strong>
            <span>{item.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="type-wall reveal" aria-labelledby="wall-page-title">
    <div class="type-wall-inner">
      <div class="type-wall-intro">
        <p class="section-label">CBS cafeteria · 1966</p>
        <h2 id="wall-page-title">Energy like the type wall in the cafeteria.</h2>
        <p>
          Dorfsman called the Gastrotypographicalassemblage his magnum opus: a typesetter’s tray turned into
          architecture inside Saarinen’s CBS Building. That appetite for word-as-object powers our brand
          language walls.
        </p>
      </div>
      <div class="type-assemblage" aria-hidden="true">
        <div class="type-cell xl span2">Letter</div>
        <div class="type-cell lg brass">Appetite</div>
        <div class="type-cell md accent">Wood</div>
        <div class="type-cell lg">Lubalin</div>
        <div class="type-cell md span2">Assemblage</div>
        <div class="type-cell xl">CBS</div>
        <div class="type-cell md brass">Dorfsman</div>
        <div class="type-cell lg">Carnase</div>
        <div class="type-cell md">Milled</div>
        <div class="type-cell lg span2">Typography</div>
        <div class="type-cell md accent">Blackrock</div>
        <div class="type-cell xl span2">Wall</div>
        <div class="type-cell sm">1966</div>
        <div class="type-cell sm">Saarinen</div>
        <div class="type-cell sm brass">1,650 letters</div>
        <div class="type-cell md">Menu</div>
        <div class="type-cell sm">Pine</div>
        <div class="type-cell lg">Form</div>
      </div>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="deco-title">
    <p class="section-label">Art Deco & structure</p>
    <div class="deco-rule" aria-hidden="true"></div>
    <h2 class="section-title" id="deco-title">Geometry that signals permanence</h2>
    <ul class="lineage">
      {
        decoAndWall.map((item) => (
          <li>
            <strong>{item.name}</strong>
            <span>{item.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section reveal" aria-labelledby="family-title">
    <p class="section-label">Family business · past websites & CI</p>
    <div class="deco-rule" aria-hidden="true"></div>
    <h2 class="section-title" id="family-title">What branding sites get right</h2>
    <p class="section-lead">
      Across heritage and family-office case studies, the strongest corporate identities and websites treat
      history as a strategic asset — then pair it with modern systems and clear digital journeys.
    </p>
    <ul class="lineage">
      {
        familyCases.map((item) => (
          <li>
            <strong>{item.name}</strong>
            <span>{item.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section reveal" aria-labelledby="principles-title">
    <p class="section-label">Playbook</p>
    <div class="deco-rule" aria-hidden="true"></div>
    <h2 class="section-title" id="principles-title">Principles for family corporate identity</h2>
    <div class="influence-grid">
      {
        familyPrinciples.map((item) => (
          <article class="influence">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section reveal" aria-labelledby="apply-title">
    <p class="section-label">How it shows up here</p>
    <div class="deco-rule" aria-hidden="true"></div>
    <h2 class="section-title" id="apply-title">Synthesis, not costume.</h2>
    <div class="influence-grid">
      <article class="influence">
        <span class="tag">Swedish</span>
        <h3>Clarity & economy</h3>
        <p>Editorial lists, system thinking, and color used with intent — design as serious business.</p>
      </article>
      <article class="influence">
        <span class="tag">Japanese</span>
        <h3>Ma & reduction</h3>
        <p>Breathing room around the brand mark. Asymmetry with balance. Less noise, more signal.</p>
      </article>
      <article class="influence">
        <span class="tag">Deco</span>
        <h3>Tall type & brass rules</h3>
        <p>Spaced capitals, stepped accents, and geometric frames that suggest permanence.</p>
      </article>
      <article class="influence">
        <span class="tag">Type wall</span>
        <h3>Word as architecture</h3>
        <p>Assemblage grids that turn vocabulary into a physical, energetic surface.</p>
      </article>
    </div>
  </section>

  <section class="contact-strip reveal" aria-labelledby="inf-cta">
    <div class="contact-strip-inner">
      <h2 id="inf-cta">Bring this rigor to your identity.</h2>
      <p>Especially if you’re stewarding a family name into its next chapter.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/contact">Start a project</a>
        <a class="btn btn-ghost" href="/work">View work</a>
      </div>
    </div>
  </section>
</Layout>
