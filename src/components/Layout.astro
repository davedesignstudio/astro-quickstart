---
import '../style/demo-styling.css'
import '../style/scroll-animations.css'

export interface Props {
	title: string;
}

const { title } = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width">
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
	<title>{title}</title>
</head>
<body>
	<slot />
	<script>
		const SLIDE_DIRECTIONS = ['up', 'left', 'right', 'down'];
		const ANIMATE_SELECTOR = [
			'#content h1',
			'#content h2',
			'#content h3',
			'#content p',
			'#content .logo',
			'#content .bttn',
			'#content .resource-list li',
			'footer',
			'footer > *',
		].join(', ');

		function prepareAnimatedElements() {
			const candidates = document.querySelectorAll(ANIMATE_SELECTOR);
			let index = 0;

			candidates.forEach((element) => {
				if (!(element instanceof HTMLElement)) return;
				if (element.id === 'background') return;
				if (element.closest('#background')) return;

				const alreadyMarked = element.classList.contains('animate-on-scroll');
				const nestedInAnimated = element.parentElement?.closest('.animate-on-scroll');

				if (!alreadyMarked && nestedInAnimated) return;

				const direction =
					element.dataset.animate ||
					SLIDE_DIRECTIONS[index % SLIDE_DIRECTIONS.length];

				element.classList.add('animate-on-scroll');
				element.dataset.animate = direction;
				element.style.setProperty('--animate-delay', `${(index % 6) * 80}ms`);
				index += 1;
			});
		}

		function initScrollAnimations() {
			prepareAnimatedElements();
			document.documentElement.classList.add('js-animate');

			const animatedElements = document.querySelectorAll('.animate-on-scroll');
			if (!animatedElements.length) return;

			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				animatedElements.forEach((element) => {
					element.classList.add('is-visible');
				});
				return;
			}

			const observer = new IntersectionObserver(
				(entries, currentObserver) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						entry.target.classList.add('is-visible');
						currentObserver.unobserve(entry.target);
					});
				},
				{
					threshold: 0.15,
					rootMargin: '0px 0px -8% 0px',
				}
			);

			// Allow the initial hidden transform to paint before observing,
			// so already-visible elements still slide in.
			requestAnimationFrame(() => {
				animatedElements.forEach((element) => observer.observe(element));
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initScrollAnimations);
		} else {
			initScrollAnimations();
		}
	</script>
</body>
</html>

<style>
  :root {
    --font-size-base: clamp(1rem, 0.34vw + 0.91rem, 1.19rem);
		--font-size-lg: clamp(1.2rem, 0.7vw + 1.2rem, 1.5rem); 
    --font-size-xl: clamp(2.44rem, 2.38vw + 1.85rem, 3.75rem);
    --color-text: hsl(12, 5%, 4%);
    --color-bg: hsl(10, 21%, 95%);
  }
  html {
    font-family: system-ui, sans-serif;
    font-size: var(--font-size-base);
    color: var(--color-text);
    background-color: var(--color-bg);
  }
  body {
    margin: 0;
  }
  :global(h1) {
    font-size: var(--font-size-xl);
  }
  :global(h2) {
    font-size: var(--font-size-lg);
  }
  :global(code) {
    font-family: Menlo, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono,
			Bitstream Vera Sans Mono, Courier New, monospace;
  }
</style>