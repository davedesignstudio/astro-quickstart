---
import '../style/global.css';

export interface Props {
  title: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = 'D. Philhower Studio crafts custom brand systems and websites with clarity, weight, and lasting presence.',
  path = Astro.url.pathname,
} = Astro.props as Props;

const fullTitle = title.includes('Philhower') ? title : `${title} · D. Philhower Studio`;
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact', cta: true },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#12141a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="logo" href="/">
        D. Philhower
        <span>Studio</span>
      </a>
      <nav class="nav" aria-label="Primary">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class={item.cta ? 'nav-cta' : undefined}
              aria-current={path === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} D. Philhower Studio</p>
      <div class="footer-links">
        <a href="/work">Work</a>
        <a href="/about">About</a>
        <a href="mailto:hello@dphilhowerstudio.com">hello@dphilhowerstudio.com</a>
      </div>
    </footer>
    <script>
      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.16, rootMargin: '0px 0px -8% 0px' }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
