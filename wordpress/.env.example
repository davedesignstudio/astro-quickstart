# Copy to .env and adjust before running: cp .env.example .env

WP_PORT=8080
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpassword

# WordPress admin (used by setup script)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=changeme
WP_ADMIN_EMAIL=admin@restaurant.local
WP_SITE_TITLE=Restaurant Online Ordering

# Restaurant printer (optional — ESC/POS network printer on port 9100)
ROS_PRINTER_HOST=
ROS_PRINTER_PORT=9100
ROS_RESTAURANT_NAME=My Restaurant
