# MySQL
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootpassword

# WordPress site URL port
WP_PORT=8080

# WordPress admin (used by setup script)
WP_TITLE="Harbor Kitchen"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=changeme
WP_ADMIN_EMAIL=owner@example.com
WP_URL=http://localhost:8080

# Optional: PrintNode for automatic kitchen ticket printing
# Get an API key at https://app.printnode.com/
ROT_PRINTNODE_API_KEY=
ROT_PRINTNODE_PRINTER_ID=
